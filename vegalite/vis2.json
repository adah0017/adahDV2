{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "title": "Do more visitors mean more spending?",
    "data": {"url": "spending.csv"},
    "layer": [
        {
            "mark": {
                "type": "arc", 
                "innerRadius": 20, 
                "stroke": "#fff"
            }
        },
        {
            "mark": {
                "type": "text", 
                "radiusOffset": 12
            },
            "encoding": {
                "text": {
                    "field": "Country",
                    "type": "nominal"
                }
            }
        }
    ],
    "encoding": {
        "theta": {
            "field": "Spending_billion",
            "type": "quantitative",
            "stack": true
        },
        "radius": {
            "field": "Spending_billion",
            "scale": {
                "type": "sqrt",
                "rangeMin": 20
            }
        },
        "color": {
            "field": "Country",
            "type": "nominal",
            "legend": null
        },
        "tooltip": [
            {"field": "Country", "type": "nominal"},
            {"field": "Spending_billion", "type": "quantitative"}
        ]
    }
}